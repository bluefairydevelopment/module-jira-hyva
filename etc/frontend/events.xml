<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        M2MAP-359. Registers view/frontend/tailwind with Hyvä's config generator so
        the theme's Tailwind build reaches this module's templates. Without it every
        utility class appearing only here is absent from the compiled CSS and the
        element renders as though the class were never written - no console error,
        no 404, just a Submit Ticket button with no vertical padding.
    -->
    <event name="hyva_config_generate_before">
        <observer name="BlueFairy_JiraHyva" instance="BlueFairy\JiraHyva\Observer\RegisterModuleForHyvaConfig"/>
    </event>
</config>
