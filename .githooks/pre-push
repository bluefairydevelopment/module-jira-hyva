#!/usr/bin/env bash
#
# pre-push for one package of the BlueFairy Jira suite (bluefairy/module-jira,
# -graph-ql and -hyva - three repositories, released in lockstep, each carrying
# this same file).
#
# TWO JOBS, and both of them can refuse a push:
#
#   1. A BRANCH push that brings new commits must change CHANGELOG.md.
#      Tags are skipped here: a tag names a commit already on the branch, so the
#      "new commits" query is empty and this rule would reject every tag push.
#
#   2. A TAG push must pass this package's own gates FIRST, and every tag pushed
#      must name HEAD with a clean working tree, because the gates read the
#      working tree. M2MAP-598 / M2MAP-546: before this, the only thing between a
#      red suite and a published tag was an UNTRACKED copy of the shared
#      ~/Sites/Modules/.git-hooks/pre-push, which asked whether CHANGELOG.md had a
#      version heading and only warned. Now CHANGELOG.md must name the version,
#      and composer validate, phpunit, phpcs and phpstan must exit 0. Exit codes
#      are read, never output.
#
# INSTALL: this file is tracked. One line per clone, once:
#
#     git config core.hooksPath .githooks
#
# Test/Unit/Package/TheReleaseGateIsArmedTest refuses the suite until that is
# done, so a clone cannot forget. `.githooks/ export-ignore` keeps it out of the
# package a merchant installs - here the repository root IS the package root.
#
# THE ROOTS ARE VANILLA INSTALLS, NEVER A MERCHANT SITE.
#
#   Module suites run against a vanilla Magento with these packages installed and
#   compiled. On this machine that is
#
#       MAGENTO_ROOT=~/Sites/magento-vanilla     (2.4.9, the latest; PHPUnit 12)
#
#   which carries phpunit, phpcs and phpstan in vendor/, so GATE_TOOLS_ROOT can be
#   left to default to it. luma.bluefairydevelopment.com (on the server) is the
#   2.4.8 reference install. Do NOT point either root at
#   ~/Sites/hyva.bluefairydevelopment.com: it is the local copy of the live store.
#
#   MAGENTO_ROOT     (required) - a Magento with phpunit in vendor/ AND this
#                    package's classes compiled into generated/code: module-jira's
#                    bootstrap REFUSES phpstan without them (M2MAP-506), and the
#                    graph-ql unit suite mocks the generated ContextExtensionInterface,
#                    which must declare getIsCustomer().
#   GATE_TOOLS_ROOT  (optional, defaults to MAGENTO_ROOT) - a Magento whose vendor/
#                    carries phpcs and phpstan.
#
#   CORRECTED 2026-10-01: this header used to name ~/Sites/bluefairydevelopment.com
#   as the root that works, and said the local hyva box failed 34 of 42 graph-ql
#   tests for want of a generated ContextExtensionInterface. That diagnosis was
#   wrong. The hyva box is 2.4.9 with PHPUnit 12, and the 34 errors were exactly the
#   suite's calls to getMockForAbstractClass(), which PHPUnit 12 removed. The unit
#   suites now run green on PHPUnit 9.6 and 12 alike.
#
#   PHPSTAN IS RUN FROM A COPY OF ITS PHAR, OUTSIDE ANY vendor/. Run in place, the
#   phar loads the composer autoloader of the vendor/ it sits in, and when that is
#   not MAGENTO_ROOT the bootstrap then registers every module twice and Magento's
#   ComponentRegistrar dies ("Module 'Mollie_HyvaCompatibility' ... has been
#   already defined"). Measured 2026-09-25, same phar, same root: in place -> that
#   crash; copied to a temp dir -> clean run, 13 generated classes resolved.
#
# CONTROL: this copy has been seen to refuse - see the "Unreleased" CHANGELOG entry
# and M2MAP-598 (planted red test, tag push refused at phpunit, in a scratch clone
# pushing to a local bare remote; the same clone with the plant removed passed all
# four gates). Re-run that control whenever this file changes; a release gate never
# seen to refuse is an untested instrument.
#
# Ported from module-recipes (M2MAP-592), which came from order-comments and
# free-gift. Single-package repo: no per-package loop.

set -u

z40=0000000000000000000000000000000000000000
has_commits=false
changelog_updated=false
tags_pushed=""
tag_shas=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue

    case "$local_ref" in
        refs/tags/*)
            # EVERY tag, not the last one read: `git push --tags` can carry several.
            tags_pushed="${tags_pushed} ${local_ref#refs/tags/}"
            tag_shas="${tag_shas} ${local_sha}"
            continue
            ;;
    esac

    # A remote sha this clone has never fetched cannot be diffed against; treat it
    # as a first push and compute the new commits instead.
    if [ "$remote_sha" != "$z40" ] && ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        remote_sha=$z40
    fi

    if [ "$remote_sha" = "$z40" ]; then
        new_commits=$(git log --format="%H" "$local_sha" --not --remotes 2>/dev/null)
        # ONE diff-tree PER COMMIT: given several at once, diff-tree compares them
        # against each other and prints nothing.
        changed=""
        if [ -n "$new_commits" ]; then
            for c in $new_commits; do
                changed="${changed}$(git diff-tree --no-commit-id -r --root --name-only "$c")
"
            done
            changed=$(echo "$changed" | sort -u)
        else
            continue
        fi
    else
        changed=$(git diff --name-only "$remote_sha" "$local_sha")
        [ -z "$changed" ] && continue
    fi

    has_commits=true

    if echo "$changed" | grep -qE '^CHANGELOG\.md$'; then
        changelog_updated=true
    fi
done

if $has_commits && ! $changelog_updated; then
    echo "" >&2
    echo "  Push rejected: CHANGELOG.md has not been updated." >&2
    echo "  Add an entry for what this changes, and commit it." >&2
    echo "" >&2
    exit 1
fi

if [ -n "$tags_pushed" ]; then
    root="$(git rev-parse --show-toplevel)"
    cd "$root" || exit 1

    # THE GATES RUN ON THE WORKING TREE, so it must BE the commit being tagged.
    # An annotated tag's sha is the tag object, hence ^{commit}.
    head=$(git rev-parse HEAD)
    for sha in $tag_shas; do
        target=$(git rev-parse "${sha}^{commit}" 2>/dev/null)
        if [ "$target" != "$head" ]; then
            echo "" >&2
            echo "  Tag push refused: a tag points at ${target:-an unknown object}, but HEAD is ${head}." >&2
            echo "  The gates measure the working tree. Check out the commit you are tagging and retry." >&2
            echo "" >&2
            exit 1
        fi
    done
    if [ -n "$(git status --porcelain)" ]; then
        echo "" >&2
        echo "  Tag push refused: the working tree has uncommitted or untracked changes." >&2
        echo "  The gates would measure them and the tag would not contain them. Commit or stash, then retry." >&2
        echo "" >&2
        exit 1
    fi

    for tag in $tags_pushed; do
        version="${tag#v}"
        if ! grep -qE "^## \[?${version//./\\.}\]?([^0-9.]|$)" "$root/CHANGELOG.md"; then
            echo "" >&2
            echo "  Tag push refused: CHANGELOG.md has no '## ${version}' heading." >&2
            echo "" >&2
            exit 1
        fi
    done

    if [ -z "${MAGENTO_ROOT:-}" ] || [ ! -f "${MAGENTO_ROOT}/vendor/autoload.php" ]; then
        echo "" >&2
        echo "  Tag push refused: MAGENTO_ROOT is not set to a Magento install." >&2
        echo "  The gates have to say which install they measured against. Export MAGENTO_ROOT" >&2
        echo "  (and GATE_TOOLS_ROOT - see this hook's header) and retry." >&2
        echo "" >&2
        exit 1
    fi
    tools_root="${GATE_TOOLS_ROOT:-$MAGENTO_ROOT}"
    stan_src="$tools_root/vendor/phpstan/phpstan/phpstan.phar"

    for tool in "$MAGENTO_ROOT/vendor/bin/phpunit" "$tools_root/vendor/bin/phpcs" "$stan_src"; do
        if [ ! -f "$tool" ]; then
            echo "" >&2
            echo "  Tag push refused: $tool does not exist." >&2
            echo "" >&2
            exit 1
        fi
    done

    echo "pre-push: release gates for tag(s)${tags_pushed}: unit + phpstan against ${MAGENTO_ROOT}, phpcs/phpstan binaries from ${tools_root}" >&2

    # ONE PRIVATE DIRECTORY PER RUN, for the logs, phpstan's cache and its phar.
    run_dir=$(mktemp -d "${TMPDIR:-/tmp}/jira-pre-push.XXXXXX") || exit 1
    mkdir "$run_dir/phpstan-tmp" || exit 1
    cp "$stan_src" "$run_dir/phpstan.phar" || exit 1

    gate() {
        local name="$1"; shift
        "$@" >"$run_dir/$name.log" 2>&1
        local status=$?
        if [ "$status" -ne 0 ]; then
            echo "" >&2
            echo "  Tag push refused: ${name} exited ${status}. Log: $run_dir/${name}.log" >&2
            echo "  A tag is a release. Fix it, or do not tag it." >&2
            echo "" >&2
            exit "$status"
        fi
        echo "pre-push: ${name} exit 0" >&2
    }

    gate composer-validate composer validate --no-check-publish --quiet
    gate phpunit env MAGENTO_ROOT="$MAGENTO_ROOT" "$MAGENTO_ROOT/vendor/bin/phpunit" -c phpunit.xml.dist
    gate phpcs "$tools_root/vendor/bin/phpcs" --standard=phpcs.xml.dist -q
    gate phpstan env MAGENTO_ROOT="$MAGENTO_ROOT" TMPDIR="$run_dir/phpstan-tmp" php "$run_dir/phpstan.phar" analyse --no-progress --memory-limit=2G
    # The denominator, carried with the green (module-jira's bootstrap prints it).
    grep -h 'generated class' "$run_dir/phpstan.log" | sort -u | sed 's/^/pre-push:   /' >&2

    # Kept on failure - the refusal names the log in it - and removed on success.
    # Each refused run leaves its directory (and the ~27 MB phar copy) in TMPDIR.
    rm -rf "$run_dir"
fi

exit 0
